# Copy to .env and fill in for your machine.
# TCP form:    postgresql://USER:PASSWORD@localhost:5432/aceout_lab?schema=public
# Socket form: postgresql://USER@localhost/aceout_lab?host=/var/run/postgresql&schema=public
DATABASE_URL="postgresql://USER@localhost/aceout_lab?host=/var/run/postgresql&schema=public"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=5000
