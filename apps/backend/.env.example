# Copy to .env and fill in for your machine.
# TCP form:    postgresql://USER:PASSWORD@localhost:5432/aceout_lab?schema=public
# Socket form: postgresql://USER@localhost/aceout_lab?host=/var/run/postgresql&schema=public
DATABASE_URL="postgresql://USER@localhost/aceout_lab?host=/var/run/postgresql&schema=public"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=5000

# Shown in the admin panel header and the app's School mode.
SCHOOL_NAME="Delhi Public School"

# Extra browser origins allowed to call the API (localhost on any port is always
# allowed). Comma separated, e.g. a deployed admin panel.
# CORS_ORIGINS="https://admin.example.com"
